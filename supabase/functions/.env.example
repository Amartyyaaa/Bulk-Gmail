# Edge Function secrets. Copy to supabase/functions/.env, fill in, then:
#   supabase secrets set --env-file supabase/functions/.env
# Never put these in the frontend .env.

ESP_PROVIDER=resend                # resend | ses
ESP_MAX_PER_SECOND=2               # provider rate limit (Resend default 2/s; SES = your account's max send rate)

# Resend
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...

# Amazon SES (when ESP_PROVIDER=ses)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=bulk-mail    # must publish events to an SNS topic
SES_WEBHOOK_TOKEN=<random string>

# Shared
APP_URL=https://mail.example.com   # where the React app is hosted (used for the unsubscribe page link)
CRON_SECRET=<random string>        # same value goes into Vault via supabase/cron.sql
PROCESS_TIME_BUDGET_MS=50000
MAX_SEND_ATTEMPTS=4
